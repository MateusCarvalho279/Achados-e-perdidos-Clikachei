# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NAO deve ser enviado para o repositorio.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=achados_perdidos

# --- Seguranca ---
# Chave de assinatura dos tokens de login. Deixe vazia para gerar uma
# automaticamente (fica salva em data/.secret_key, fora do git).
SECRET_KEY=

# Conta de administrador criada na primeira execucao
ADMIN_EMAIL=admin@cotemig.com.br
ADMIN_PASSWORD=admin123

# Conta de teste (perfil aluno) exibida na tela inicial
TEST_ACCOUNT_NAME=Visitante (Conta de Teste)
TEST_ACCOUNT_EMAIL=teste@cotemig.com.br
TEST_ACCOUNT_PASSWORD=teste123

# --- Servidor ---
APP_HOST=127.0.0.1
APP_PORT=8000
FLASK_DEBUG=1
